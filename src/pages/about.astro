---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error('缺少 src/content/pages/about.md');
}
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} · LynCiel`} description={entry.data.description}>
  <section class="page-head">
    <h1>{entry.data.title}</h1>
    {entry.data.description && <p>{entry.data.description}</p>}
  </section>

  <div class="post-body">
    <Content />
  </div>
</BaseLayout>
